# Copy to .env.local and fill in values from Supabase:
# Project Settings > API (Project URL) and API Keys (Publishable key).
# Never add the service_role / secret key to this app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
